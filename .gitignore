# --- Secrets / credentials — NEVER commit (Supabase keys, .env, etc.) ---
.env
.env.*
*.key
**/secrets*

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Python (ingestion scripts) ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# --- Obsidian (vault lives in-repo at /vault) ---
# Keep plugin/appearance/hotkey config so the vault is portable;
# ignore only the volatile workspace + cache files that churn constantly.
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/workspace.json.bak
vault/.obsidian/cache/

# --- Raw source data stays out of git (decided phase 2, 2026-07-27) ---
# Inputs are not versioned; the committed loader + the human-verified manifests
# under database/crosswalks/ carry the audit trail instead.
**/data/raw/

# Same rule for the register's source PDFs — the 2026-07-28 decision names the
# OVAM/MONBIO PDFs explicitly. ~57 MB of grey literature; the audit trail is the
# committed streams_export.csv + log.md, verified by a human against the local
# archive/ copy. Remove these two lines if the PDFs should be versioned after all.
database/register/inbox/
database/register/archive/
